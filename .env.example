# GitLab — glab only (no GitLab MCP). `glab auth login` or GITLAB_TOKEN.
GITLAB_HOST=gitlab.com
GITLAB_PROJECT=
GITLAB_TOKEN=

# Neon — CLI only (`neon auth` or NEON_API_KEY). No Neon MCP.
NEON_API_KEY=
# Only for multi-org accounts; set to the org id that owns product projects.
NEON_ORG_ID=
# Optional provisioning hints for core/scripts/ensure-neon-project.mjs.
NEON_PROJECT_NAME=
NEON_REGION_ID=aws-us-east-2
# Preview services (Functions, Storage, AI Gateway) require aws-us-east-2.

# Paddle sandbox MCP (required for billing work). Live MCP uses OAuth.
PADDLE_SANDBOX_API_KEY=

# Expo — CLI only (`eas login` or EXPO_TOKEN in CI). No Expo MCP.
EXPO_TOKEN=
