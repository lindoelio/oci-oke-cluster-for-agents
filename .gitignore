# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
src/terraform.tfstate
src/terraform.tfstate.*
src/.terraform

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# But keep the example file
!terraform.tfvars.example
!src/terraform.tfvars.example

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore kubeconfig files
kubeconfig
*.kubeconfig

# Ignore OCI CLI config
.oci/

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Helm
.helm/

# Terraform plan files
tfplan
*.tfplan
tfplan.*

# Specs
.specs

# Local scratch (tokens, notes)
.tmp/
src/.tmp/

# Stray curl cookie jar (session cookies — never commit)
src/300

# Operator-only scripts (secrets, company wiring). Terraform helpers below
# are tracked because `terraform apply` reads them from this directory.
src/scripts/*
!src/scripts/opencode.Dockerfile
!src/scripts/qwen.Dockerfile
!src/scripts/qwen-settings.json
!src/scripts/detect_ingress_ip.py
!src/scripts/cdp_proxy.js
!src/scripts/paperclip_onboard.sh
!src/scripts/company_auth_writer.js
!src/scripts/opencode_go_auth.py
!src/scripts/gen_qwen_htpasswd.sh
