# =============================================================================
# OKE cluster with Paperclip and Qwen Code Web. OpenClaw and OpenCode Web are optional.
# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
# =============================================================================

# --- Project ---
project_prefix = "myproject"

# --- OCI General ---
# Get these from: oci iam compartment list --compartment-id-in-subtree true
oci_tenancy_id   = "ocid1.tenancy.oc1..aaaaaaaa..."
oci_region       = "sa-saopaulo-1"
oci_home_region  = "sa-saopaulo-1"

# Parent compartment (all resources go into a child compartment under this)
oci_compartment_id = "ocid1.tenancy.oc1..aaaaaaaa..."

# Existing project compartment (optional — if set, uses this instead of creating a new one)
# oci_project_compartment_id = "ocid1.compartment.oc1..aaaaaaaa..."

# Public worker IPs avoid a NAT Gateway; review network exposure and pricing.
oci_public_workers = true
# Replace the documentation-only IP with your public operator/VPN egress CIDR.
oci_control_plane_allowed_cidrs = ["203.0.113.10/32"]

# --- Node Pool ---
# 4 OCPUs / 24 GB total. Check account-specific compute allowances.
# Default boot + data volumes exceed the shared 200 GB free storage allowance.
oci_oke_node_shape               = "VM.Standard.A1.Flex"
oci_oke_node_pool_size           = 2
oci_oke_node_shape_ocpus         = 2
oci_oke_node_shape_memory_in_gbs = 12

# --- App toggles ---
enable_paperclip = true
enable_openclaw  = false
enable_opencode  = false
enable_qwen      = true   # requires scripts/gen_qwen_htpasswd.sh

# --- Paperclip (Agent Orchestration UI) ---
# Paperclip is deployed directly (no operator) with a self-managed PostgreSQL StatefulSet
# paperclip_image_repository = "ghcr.io/paperclipai/paperclip"
# paperclip_image_tag        = "2026.831.1"
# enable_paperclip_qmd       = true   # qmd on the PVC via the qmd-setup initContainer (no registry/Docker needed)
# paperclip_qmd_version      = "2.5.3"
# paperclip_qmd_installer_image = "docker.io/library/node:24-slim"
paperclip_exposure          = "private"  # Start private; see README before enabling shared Ingress
# paperclip_public_url       = ""  # Auto-detected from Ingress LB IP when empty. Set to override.
# paperclip_custom_domain    = "paperclip.example.com"  # HTTPS also requires letsencrypt_email, DNS, and certificate readiness
# letsencrypt_email          = "admin@example.com"  # Required for Let's Encrypt ACME
# oci_native_ingress_version = "1.4.5"
# cert_manager_version       = "1.21.1"
# Required for simultaneous Paperclip + Qwen HTTPS on OCI regions that allow
# only one certificate per listener. See docs/launch-readiness.md.
# oci_native_shared_certificate_ocid = "ocid1.certificate..."
# paperclip_db_storage_size  = "50Gi"
# paperclip_storage_size     = "50Gi"
# paperclip_cpu_limit        = "1500m"
# paperclip_memory_limit     = "6Gi"
# paperclip_cheap_model = "openrouter/nvidia/nemotron-3.5-lightning:free"  # opencode_local budget lane (recovery retries); any provider/model
# enable_paperclip_browser = true   # headless Chromium (CDP) service for agent browser automation
# paperclip_browser_version = "1.62.1"

# LLM API Keys (at least one required for Paperclip agents)
# All keys are optional — Paperclip will use whichever providers are configured
# anthropic_api_key = "sk-ant-..."
# openai_api_key    = "sk-..."
# openrouter_api_key = "sk-or-v1-..."  # Enables OpenRouter (Pi, Hermes, OpenCode, etc.)
# ollama_cloud_api_key = "sk-oll-..."   # Enables Ollama Cloud models

# Developer credentials (injected into Paperclip and OpenCode Web agent envs)
# github_token = "ghp_..."               # GitHub PAT (scopes: repo, workflow) for gh CLI
# gcp_service_account_key = <<EOT        # GCP service account key JSON for gcloud
# { "type": "service_account", ... }
# EOT
# firebase_token = "1//..."              # Firebase CLI token (firebase login:ci)
# Optional CLI credentials injected into OpenCode Web
# gitlab_token              = "glpat-..."   # GitLab PAT (api, write_repository) for glab
# gitlab_preview_token      = "glpat-..."   # GitLab preview token (optional, masked CI var)
# neon_api_key              = "..."         # Neon API key for neon/neonctl
# neon_org_id               = "..."         # Neon org id (multi-org accounts)
# expo_token                = "..."         # Expo access token for eas
# paddle_sandbox_api_key    = "..."         # Paddle sandbox key for paddle-sandbox MCP

# --- OpenCode Web (optional Agent Interface) ---
# Before deployment, build and push the matching image tag (see README).
# OpenCode Web is built from the upstream ARM64 release tarball
opencode_exposure = "private"  # Public OCI Native Ingress requires opencode_custom_domain
# opencode_custom_domain = "opencode.example.com"  # HTTPS also requires letsencrypt_email, DNS, and certificate readiness
# opencode_version       = "1.17.13"    # Upstream version to build from tarball
# opencode_storage_size  = "50Gi"
# opencode_cpu_limit     = "500m"
# opencode_memory_limit  = "8Gi"
# External registry credentials (GHCR, Docker Hub, etc.)
# opencode_registry            = "ghcr"  # or "dockerhub"
# opencode_registry_username = "your-username"
# opencode_registry_token  = "ghp_... or dckr_pat_..."  # Personal access token with write:packages scope
# opencode_registry_namespace = "your-namespace"

# LLM API Keys (optional — reuses Paperclip keys if set; set only if you want different credentials)
# anthropic_api_key    = "sk-ant-..."
# openai_api_key       = "sk-..."
# openrouter_api_key   = "sk-or-v1-..."
# ollama_cloud_api_key = "sk-oll-..."

# --- Qwen Code Web ---
# The PVC is mounted at /home/qwen/projects. The empty sandbox directory is
# the fallback workspace; clone repositories as sibling directories and
# register each repository as its own persistent Qwen workspace.
# qwen_version       = "0.23.0"
# qwen_storage_size  = "50Gi"
# qwen_cpu_limit     = "1500m"
# qwen_memory_limit  = "6Gi"
# qwen_custom_domain = "qwen.example.com"

# --- OpenClaw (Agent Runtime) ---
# OpenClaw is deployed via the openclaw-operator Helm chart
# openclaw_chart_version     = "0.36.5"  # default in variables.tf
# openclaw_image_repository  = "ghcr.io/openclaw/openclaw"
# openclaw_image_tag         = "latest"
openclaw_llm_provider    = "openrouter"
openclaw_llm_model       = "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
openclaw_llm_api_key     = "your-llm-api-key-here"
# openclaw_storage_size    = "50Gi"
# openclaw_cpu_limit       = "500m"
# openclaw_memory_limit    = "2Gi"

# Telegram integration (optional)
openclaw_telegram_enabled   = true
openclaw_telegram_bot_token = "123456:ABC-DEF..."
# openclaw_telegram_owner_id = "123456789"  # Telegram numeric user ID for auto-approval
# deepinfra_api_key = "..."  # DeepInfra (OpenAI-compatible) keys for agent models
